APP_NAME=Laravel
APP_ENV=local
# APP_KEY bo'sh qoldiriladi. Birinchi o'rnatishda BIR MARTA:
#   php artisan key:generate
# Keyingi deploylarda mavjud kalit saqlanadi - uni qayta yaratish
# barcha shifrlangan qiymatlar va sessiyalarni buzadi.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=postgres
DB_PASSWORD=secret!secret!
DB_LOCAL_PORT=127.0.0.1:5400

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=secret!
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=
RABBITMQ_EXCHANGE_NAME=default

RECAPTCHA_SITE_KEY=site_key
RECAPTCHA_SECRET_KEY=secret_key
RECAPTCHA_SITE=https://www.google.com/recaptcha/api/siteverify

# JWT_SECRET bo'sh qoldiriladi. Birinchi o'rnatishda BIR MARTA:
#   php artisan jwt:secret
# Uni almashtirish barcha amaldagi tokenlarni bekor qiladi.
JWT_SECRET=
JWT_REFRESH_TTL=10080
JWT_TTL=30

AUTHENTICATION_PROVIDER_MAIL=mail
AUTHENTICATION_PROVIDER_GOOGLE=google
AUTHENTICATION_PROVIDER_PHONE=phone

# ---------------------------------------------------------------------
# CORS - Laravel yagona CORS egasi (nginx darajasidagi nusxa olib tashlandi)
# Vergul bilan ajratilgan aniq frontend originlar. `*` ishlatilmaydi.
# ---------------------------------------------------------------------
# Diqqat: ro'yxatda aynan BITTA origin bo'lsa, php-cors kutubxonasi
# `Access-Control-Allow-Origin` ni so'rovdagi Origin'dan qat'i nazar
# statik qo'yadi. Serverda haqiqiy origin tekshiruvi bo'lishi uchun
# kamida ikkita origin yozing.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:8000"

# ---------------------------------------------------------------------
# Fayllar
# Yuklangan fayllar web root'dan tashqarida saqlanadi va faqat
# avtorizatsiya qiluvchi `api/file-view` marshruti orqali beriladi.
# ---------------------------------------------------------------------
FILESYSTEM_UPLOAD_DISK=private

# ---------------------------------------------------------------------
# OTP (elektron pochta orqali kirish kodi)
# ---------------------------------------------------------------------
MAIL_CODE_EXPIRE_AT=5
MAIL_CODE_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# Birinchi admin hisobi.
# Faqat BIRINCHI o'rnatishda kerak. Parol bo'sh bo'lsa AdminUserSeeder
# to'xtaydi va hech qanday admin yaratmaydi. Mavjud admin hech qachon
# qayta yozilmaydi. Bu qiymatlarni serverda ishlatgandan keyin olib
# tashlash tavsiya etiladi.
# ---------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------
# Autentifikatsiya provayderlari (config/auth.php ishlatadi)
# ---------------------------------------------------------------------
AUTHENTICATION_PROVIDER_ADMIN=admin

# ---------------------------------------------------------------------
# Google OAuth (ixtiyoriy - Google orqali kirish yoqilgan bo'lsa kerak)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------
# Payme (ixtiyoriy). Bo'sh qoldirilsa to'lov qabul qilinmaydi:
# middleware bo'sh sir bilan hech kimni autentifikatsiya qilmaydi.
# ---------------------------------------------------------------------
PAYME_MERCHANT_ID=
PAYME_LOGIN=
PAYME_KEY=
PAYME_URL=
PAYME_TEST_MODE=true

# ---------------------------------------------------------------------
# Click (ixtiyoriy). Yuqoridagi kabi - bo'sh bo'lsa fail closed.
# ---------------------------------------------------------------------
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_BASE_URL=

# ---------------------------------------------------------------------
# Telescope - faqat dev. Productionda o'chirilgan bo'lishi shart.
# ---------------------------------------------------------------------
TELESCOPE_ENABLED=false
